{
  "name": "ai-design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "generate": "node packages/orchestrator/src/generate.js",
    "validate": "node scripts/validate-architecture.mjs && node packages/orchestrator/src/generate.js --check",
